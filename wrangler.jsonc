{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sakhicycle",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sakhicycle-db",
      "database_id": "26117117-6bfe-4937-8bac-4a05d2f063e9"
    }
  ],
  "vars": {
    "APP_NAME": "Sakhicycle",
    // Google sign-in only: the free Workers plan allows 10 ms of CPU per request,
    // and password hashing does not fit inside that budget.
    "PASSWORD_AUTH": "off"
  }
}
